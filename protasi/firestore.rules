rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // New, per-user data — only the owning, invited account can read/write its own tree.
    // The `invited` custom claim is set exclusively by api/signup.ts and api/admin-grant.ts
    // (Admin SDK), so a stray account created some other way has zero access here.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.invited == true;
    }

    // TRANSITIONAL — the app's original flat, unscoped data model, kept readable/writable
    // by any signed-in user only until the one-time migration into users/{uid}/... is
    // confirmed complete. Remove this block afterward (see plan: "Tighten security rules").
    match /collections/{id} {
      allow read, write: if request.auth != null;
    }
    match /sentences/{id} {
      allow read, write: if request.auth != null;
    }
    match /app/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
